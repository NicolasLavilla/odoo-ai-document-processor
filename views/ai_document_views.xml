<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_document_view_tree" model="ir.ui.view">
        <field name="name">ai.document.tree</field>
        <field name="model">ai.document</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="document_type"/>
                <field name="confidence"/>
                <field name="state"/>
                <field name="processed_at"/>
            </list>
        </field>
    </record>

    <record id="ai_document_view_form" model="ir.ui.view">
        <field name="name">ai.document.form</field>
        <field name="model">ai.document</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_process" type="object" string="Procesar con IA" class="oe_highlight" invisible="state not in ('draft','error','needs_review')"/>
                    <button name="action_mark_reviewed" type="object" string="Confirmar revisión" invisible="state != 'needs_review'"/>
                    <button name="action_link_records" type="object" string="Crear / enlazar en Odoo" class="oe_highlight" invisible="state != 'reviewed'"/>
                    <button name="action_sync_delivery_note_references" type="object" string="Actualizar albaranes citados" invisible="state != 'done' or document_type != 'invoice' or linked_model != 'account.move'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="document_type"/>
                            <field name="original_file" filename="original_filename"/>
                            <field name="original_filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="confidence"/>
                            <field name="confidence_threshold"/>
                            <field name="auto_create_records"/>
                            <field name="processed_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Resultado OCR">
                            <field name="result_json" widget="text"/>
                        </page>
                        <page string="Errores" invisible="not error_message">
                            <field name="error_message"/>
                        </page>
                        <page string="Avisos" invisible="not review_warnings">
                            <field name="review_warnings" readonly="1"/>
                        </page>
                        <page string="Registro enlazado">
                            <field name="linked_model"/>
                            <field name="linked_record_id"/>
                            <field name="delivery_note_reference_id" invisible="document_type != 'delivery_note'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ai_document_action" model="ir.actions.act_window">
        <field name="name">Documentos OCR</field>
        <field name="res_model">ai.document</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- web_icon is required for the app to render its own tile in the app
         switcher; without it Odoo has no icon to render and the menu ends
         up folded oddly into whatever app happens to be open. -->
    <menuitem id="menu_ai_document_root" name="Documentos OCR" sequence="60" web_icon="ai_document_processor,static/description/icon.png"/>
    <menuitem id="menu_ai_document_main" name="Documentos" parent="menu_ai_document_root" action="ai_document_action" sequence="10"/>
</odoo>
