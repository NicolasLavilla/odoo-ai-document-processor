<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ai_document" model="ir.module.category">
        <field name="name">AI Document Processor</field>
    </record>

    <!-- Odoo 19: res.groups no longer links directly to ir.module.category
         via category_id. Groups are grouped under a res.groups.privilege,
         which in turn links to the module category. -->
    <record id="privilege_ai_document" model="res.groups.privilege">
        <field name="name">AI Document Processor</field>
        <field name="category_id" ref="module_category_ai_document"/>
    </record>

    <record id="group_ai_document_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_ai_document"/>
    </record>

    <record id="group_ai_document_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_ai_document"/>
        <field name="implied_ids" eval="[(4, ref('group_ai_document_user'))]"/>
    </record>

    <record id="rule_ai_document_company" model="ir.rule">
        <field name="name">Documentos OCR: empresas permitidas</field>
        <field name="model_id" ref="model_ai_document"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_ai_delivery_note_reference_company" model="ir.rule">
        <field name="name">Albaranes OCR: empresas permitidas</field>
        <field name="model_id" ref="model_ai_delivery_note_reference"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
